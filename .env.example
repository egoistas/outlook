# DNS name only, no scheme/path/port. Create an A record pointing to the VM.
CALENDAR_HOST=calendar.example.internal
BIND_IP=0.0.0.0
# Major/minor pinned; record exact image digests when preparing an offline release.
NEXTCLOUD_IMAGE=nextcloud:34-apache
POSTGRES_IMAGE=postgres:17-alpine
REDIS_IMAGE=redis:7.4-alpine
NGINX_IMAGE=nginx:1.28-alpine

# Choose an unused subnet, distinct from LAN/VPN and other Docker networks.
DOCKER_SUBNET=172.29.88.0/24
PROXY_IP=172.29.88.10
